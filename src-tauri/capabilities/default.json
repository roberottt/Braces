{
  "identifier": "default",
  "description": "Default capabilities for Braces — grants core IPC, event listen/emit, and window access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "shell:allow-spawn",
    "shell:allow-execute"
  ]
}
